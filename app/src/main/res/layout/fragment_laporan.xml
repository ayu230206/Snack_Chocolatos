<?xml version="1.0" encoding="utf-8"?>
<!-- Pertemuan 10: CoordinatorLayout + AppBarLayout agar Toolbar dan ListView harmonis -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sikuda_latar"
    tools:context=".laporan.LaporanFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sikuda_latar"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/sikuda_latar"
            app:contentInsetStart="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Laporan Periodik"
                    android:textColor="@color/sikuda_teks"
                    android:textSize="17sp" />
            </FrameLayout>
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Isi halaman berada tepat di bawah AppBar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/layoutAtas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Tab periode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_tab_periode"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabPerBulan"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_aktif"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Per Bulan"
                    android:textColor="@color/sikuda_putih"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tabPerTahun"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Per Tahun"
                    android:textColor="@color/sikuda_teks_2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tabRentang"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="Rentang"
                    android:textColor="@color/sikuda_teks_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Pemilih periode -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPemilihPeriode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sikuda_putih"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/btnPeriodeSebelum"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:contentDescription="Periode sebelumnya"
                        android:src="@drawable/ic_chevron_left_grey" />

                    <TextView
                        android:id="@+id/textPeriode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="September 2026"
                        android:textColor="@color/sikuda_teks"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnPeriodeSesudah"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="Periode berikutnya"
                        android:src="@drawable/ic_chevron_right_grey" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pemilih rentang tanggal (khusus tab Rentang) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRentang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/sikuda_putih"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/boxTanggalDari"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_kotak_tanggal"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Dari"
                                android:textColor="@color/sikuda_abu_muda"
                                android:textSize="10sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="Tanggal dari"
                                    android:src="@drawable/ic_kalender"
                                    app:tint="@color/sikuda_teks_2" />

                                <TextView
                                    android:id="@+id/textTanggalDari"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="1 Sep 2026"
                                    android:textColor="@color/sikuda_teks"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/boxTanggalSampai"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_kotak_tanggal_aktif"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Sampai"
                                android:textColor="@color/sikuda_abu_muda"
                                android:textSize="10sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="Tanggal sampai"
                                    android:src="@drawable/ic_kalender"
                                    app:tint="@color/sikuda_teks_2" />

                                <TextView
                                    android:id="@+id/textTanggalSampai"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="15 Sep 2026"
                                    android:textColor="@color/sikuda_teks"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ringkasan: Pemasukan, Pengeluaran, Laba Bersih -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/sikuda_putih"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_kotak_masuk"
                            android:contentDescription="Pemasukan"
                            android:padding="7dp"
                            android:src="@drawable/ic_panah_masuk"
                            app:tint="@color/sikuda_kas_masuk" />

                        <TextView
                            android:id="@+id/textPemasukan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp140,9 jt"
                            android:textColor="@color/sikuda_kas_masuk"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Pemasukan"
                            android:textColor="@color/sikuda_teks_2"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/sikuda_putih"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_kotak_keluar"
                            android:contentDescription="Pengeluaran"
                            android:padding="7dp"
                            android:src="@drawable/ic_panah_keluar"
                            app:tint="@color/sikuda_kas_keluar" />

                        <TextView
                            android:id="@+id/textPengeluaran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp83,7 jt"
                            android:textColor="@color/sikuda_kas_keluar"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Pengeluaran"
                            android:textColor="@color/sikuda_teks_2"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/sikuda_putih"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_kotak_masuk"
                            android:contentDescription="Laba Bersih"
                            android:padding="7dp"
                            android:src="@drawable/ic_tren_naik"
                            app:tint="@color/sikuda_primary" />

                        <TextView
                            android:id="@+id/textLabaBersih"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Rp57,2 jt"
                            android:textColor="@color/sikuda_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Laba Bersih"
                            android:textColor="@color/sikuda_teks_2"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/textJudulRincian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Rincian per Jenis"
                android:textColor="@color/sikuda_teks"
                android:textSize="15sp" />

            <!-- Grafik Laba Bersih per Bulan (khusus tab Per Tahun) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGrafikTahunan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/sikuda_putih"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Laba Bersih per Bulan"
                        android:textColor="@color/sikuda_teks"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textSubjudulGrafik"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Jan – Sep 2026 · dalam juta rupiah"
                        android:textColor="@color/sikuda_abu_muda"
                        android:textSize="11sp" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chartLabaTahunan"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/textKeteranganGrafik"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Rata-rata Rp60 jt / bulan · tertinggi Agustus"
                        android:textColor="@color/sikuda_teks_2"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ListView Rincian per Jenis di dalam kartu putih -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRincian"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/sikuda_putih"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@id/btnExportLaporan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAtas"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed"
            app:strokeWidth="0dp">

            <ListView
                android:id="@+id/listViewItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:divider="@drawable/bg_divider_laporan"
                android:dividerHeight="1dp"
                android:paddingVertical="6dp"
                android:scrollbars="none" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportLaporan"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/sikuda_primary"
            android:fontFamily="@font/poppins_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Export Laporan"
            android:textAllCaps="false"
            android:textColor="@color/sikuda_putih"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_unduh"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/sikuda_putih"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardRincian" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
