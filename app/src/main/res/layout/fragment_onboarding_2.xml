<?xml version="1.0" encoding="utf-8"?>
<!-- Halaman onboarding ke-2: ilustrasi, judul, deskripsi -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sikuda_latar"
    tools:context=".sikuda.onboarding.Onboarding2Fragment">

    <ImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Ilustrasi SIKUDA Pantau"
        android:src="@drawable/img_onboarding_2"
        app:layout_constraintDimensionRatio="720:680"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Jarak 52dp: ruang untuk DotsIndicator milik Activity -->
    <TextView
        android:id="@+id/textJudul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="52dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/onboarding_judul_2"
        android:textColor="@color/sikuda_primary_dark"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgOnboarding" />

    <TextView
        android:id="@+id/textDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="@string/onboarding_desc_2"
        android:textColor="@color/sikuda_teks_2"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textJudul" />

</androidx.constraintlayout.widget.ConstraintLayout>
