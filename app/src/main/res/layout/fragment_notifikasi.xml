<?xml version="1.0" encoding="utf-8"?>
<!-- Pertemuan 10: CoordinatorLayout + AppBarLayout untuk Toolbar, ListView di bawahnya -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sikuda_latar"
    tools:context=".notifikasi.NotifikasiFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sikuda_latar"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/sikuda_latar"
            app:contentInsetStart="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Notifikasi"
                    android:textColor="@color/sikuda_teks"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/textTandaiDibaca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:padding="4dp"
                    android:text="Tandai dibaca"
                    android:textColor="@color/sikuda_primary"
                    android:textSize="12sp" />
            </FrameLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Chip & ChipGroup: filter notifikasi per kategori -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="7dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSemua"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Semua"
                    android:textColor="@color/chip_teks_notifikasi"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_notifikasi"
                    app:chipCornerRadius="17dp"
                    app:chipEndPadding="0dp"
                    app:chipMinHeight="34dp"
                    app:chipStartPadding="0dp"
                    app:chipStrokeColor="@color/chip_stroke_notifikasi"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    app:textEndPadding="11dp"
                    app:textStartPadding="11dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTransaksi"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Transaksi"
                    android:textColor="@color/chip_teks_notifikasi"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_notifikasi"
                    app:chipCornerRadius="17dp"
                    app:chipEndPadding="0dp"
                    app:chipMinHeight="34dp"
                    app:chipStartPadding="0dp"
                    app:chipStrokeColor="@color/chip_stroke_notifikasi"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    app:textEndPadding="11dp"
                    app:textStartPadding="11dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHargaTbs"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Harga TBS"
                    android:textColor="@color/chip_teks_notifikasi"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_notifikasi"
                    app:chipCornerRadius="17dp"
                    app:chipEndPadding="0dp"
                    app:chipMinHeight="34dp"
                    app:chipStartPadding="0dp"
                    app:chipStrokeColor="@color/chip_stroke_notifikasi"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    app:textEndPadding="11dp"
                    app:textStartPadding="11dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAnggota"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Anggota"
                    android:textColor="@color/chip_teks_notifikasi"
                    android:textSize="12sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_bg_notifikasi"
                    app:chipCornerRadius="17dp"
                    app:chipEndPadding="0dp"
                    app:chipMinHeight="34dp"
                    app:chipStartPadding="0dp"
                    app:chipStrokeColor="@color/chip_stroke_notifikasi"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    app:textEndPadding="11dp"
                    app:textStartPadding="11dp" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

    </com.google.android.material.appbar.AppBarLayout>

    <ListView
        android:id="@+id/listNotifikasiItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
