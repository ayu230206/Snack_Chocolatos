<?xml version="1.0" encoding="utf-8"?>
<!-- Pertemuan 11: Onboard Screen dengan ViewPager2 + DotsIndicator -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sikuda_latar"
    tools:context=".sikuda.OnboardingActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sikuda_latar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol Lewati (sesuai Figma) -->
        <TextView
            android:id="@+id/textLewati"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:padding="8dp"
            android:text="Lewati"
            android:textColor="@color/sikuda_teks_2"
            android:textSize="14sp" />
    </androidx.appcompat.widget.Toolbar>

    <!-- ViewPager2: 3 halaman onboarding yang bisa digeser -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboardingViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnWebsite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Penanda tinggi ilustrasi (rasio sama dengan gambar) agar titik pas di bawah gambar -->
    <View
        android:id="@+id/penandaIlustrasi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintDimensionRatio="720:680"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- DotsIndicator: titik penanda halaman aktif -->
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dot_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:dotsColor="@color/sikuda_dot"
        app:dotsCornerRadius="4dp"
        app:dotsSize="8dp"
        app:dotsSpacing="4dp"
        app:dotsWidthFactor="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/penandaIlustrasi"
        app:progressMode="false"
        app:selectedDotColor="@color/sikuda_primary" />

    <!-- Tombol Kunjungi Website -->
    <Button
        android:id="@+id/btnWebsite"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Kunjungi Website"
        android:textColor="@color/sikuda_primary"
        android:textSize="15sp"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_language"
        app:iconGravity="textStart"
        app:iconTint="@color/sikuda_primary"
        app:layout_constraintBottom_toTopOf="@id/btnLanjut"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/sikuda_primary"
        app:strokeWidth="1.5dp" />

    <!-- Tombol Lanjut / Mulai Sekarang -->
    <Button
        android:id="@+id/btnLanjut"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/sikuda_primary"
        android:fontFamily="@font/poppins_semibold"
        android:text="Lanjut"
        android:textColor="@color/sikuda_putih"
        android:textSize="15sp"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="textStart"
        app:iconTint="@color/sikuda_putih"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
