<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    tools:context=".SplashScreenActivity">

  <!-- Logo -->
  <com.google.android.material.card.MaterialCardView
      android:id="@+id/cardLogo"
      android:layout_width="120dp"
      android:layout_height="120dp"
      app:cardBackgroundColor="@color/sikuda_putih"
      app:cardCornerRadius="30dp"
      app:cardElevation="10dp"
      app:strokeWidth="0dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintVertical_bias="0.37">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/logo_daun"
        android:contentDescription="@string/app_name_sikuda" />
  </com.google.android.material.card.MaterialCardView>

  <!-- SIKUDA (putih) + Pantau (oranye) -->
  <LinearLayout
      android:id="@+id/layoutJudul"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="28dp"
      android:orientation="horizontal"
      app:layout_constraintTop_toBottomOf="@id/cardLogo"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIKUDA "
        android:textColor="@color/sikuda_putih"
        android:textSize="30sp"
        android:fontFamily="@font/poppins_extrabold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pantau"
        android:textColor="@color/sikuda_pantau"
        android:textSize="30sp"
        android:fontFamily="@font/poppins_semibold" />
  </LinearLayout>

  <TextView
      android:id="@+id/textTagline"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/tagline"
      android:textColor="@color/sikuda_hijau_pucat"
      android:textSize="14sp"
      android:fontFamily="@font/poppins_regular"
      app:layout_constraintTop_toBottomOf="@id/layoutJudul"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <TextView
      android:id="@+id/textNamaKud"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="KUD Lubuk Karya"
      android:textColor="@color/sikuda_putih"
      android:textSize="13sp"
      android:fontFamily="@font/poppins_semibold"
      app:layout_constraintBottom_toTopOf="@id/textVersi"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <TextView
      android:id="@+id/textVersi"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="48dp"
      android:text="@string/versi"
      android:textColor="@color/sikuda_versi"
      android:textSize="11sp"
      android:fontFamily="@font/poppins_regular"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>