<?xml version="1.0" encoding="utf-8"?>
<!-- Layout 1 baris ListView "Rincian per Jenis": ikon, judul, jumlah transaksi, nominal -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/imgIkon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_ikon_hijau"
        android:contentDescription="Ikon jenis laporan"
        android:padding="9dp"
        app:tint="@color/sikuda_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textJudul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Transaksi Kas"
            android:textColor="@color/sikuda_teks"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="42 transaksi"
            android:textColor="@color/sikuda_abu_muda"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textNominal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Rp12,4 jt"
        android:textColor="@color/sikuda_teks"
        android:textSize="13sp" />

</LinearLayout>
